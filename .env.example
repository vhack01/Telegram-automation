# ── Telegram ──────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: Your channel's numeric ID (e.g. -1001234567890)
# Leave blank to monitor ALL channels the bot is in
TELEGRAM_CHANNEL_ID=

# ── Twilio ────────────────────────────────────────────────
# From https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number (must be in E.164 format)
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Alert Target ──────────────────────────────────────────
# The phone number to call when name is detected
YOUR_PHONE_NUMBER=+919569288612

# ── Detection Settings ────────────────────────────────────
# Comma-separated names to watch for (case-insensitive)
WATCH_NAMES=Mantsa

# Cooldown between calls in seconds (default: 300 = 5 minutes)
# Set to 0 to disable cooldown (not recommended)
CALL_COOLDOWN_SECONDS=300

# ── Optional Security ─────────────────────────────────────
# A random string to verify webhook requests come from Telegram
# Generate one at: https://www.uuidgenerator.net/
WEBHOOK_SECRET=
