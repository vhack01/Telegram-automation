# ── Telegram ──────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your channel's numeric ID (e.g. -1004421220654)
TELEGRAM_CHANNEL_ID=-1004421220654

# Your personal Telegram chat ID (bot will DM you here)
# How to get it: Message @userinfobot on Telegram → it replies with your ID
TELEGRAM_OWNER_CHAT_ID=your_personal_chat_id_here

# ── Detection Settings ────────────────────────────────────
# Comma-separated names to watch for (case-insensitive)
WATCH_NAMES=Mantsa

# Cooldown between alerts in seconds (default: 300 = 5 minutes)
CALL_COOLDOWN_SECONDS=300

# ── App URL ───────────────────────────────────────────────
APP_URL=https://your-railway-url.up.railway.app

# ── Optional Security ─────────────────────────────────────
WEBHOOK_SECRET=
